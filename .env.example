# Copy to .env (repo root, dev) or ~/Library/Application Support/Cadence/.env (bundled app). Never commit real values.
PORT=8796
# Images: Open Generative AI MCP with CatGPT pinned (no other provider fallback).
CADENCE_IMAGE_PROVIDER=oga-mcp
# Optional custom path; defaults to ~/Projects/open-generative-ai-mcp/src/index.js
CADENCE_OGA_MCP_ENTRY=
# Explicit alternative providers: CADENCE_IMAGE_PROVIDER=openai or catgpt.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
CATGPT_GATEWAY_URL=http://localhost:8000/v1
CATGPT_GATEWAY_TOKEN=
CATGPT_IMAGE_MODEL=chatgpt
# LLM: Claude Code CLI (Pro) first, 9Router fallback.
CADENCE_TEXT_PROVIDER=9router
# Set CADENCE_TEXT_PROVIDER=9router to use the configured router model directly.
CADENCE_CLAUDE_BIN=claude
CADENCE_MODEL=opus
NINE_ROUTER_URL=http://localhost:20128/v1
NINE_ROUTER_API_KEY=
CADENCE_FALLBACK_MODEL=cx/gpt-5.6-terra
# Public media hosting for Instagram / Threads / Pinterest.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=cadence-media
