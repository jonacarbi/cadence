# Cadence settings. Optional: the web app's Settings screen writes these for you.
# Copy to .env in the repo root (dev) or into the Cadence data folder:
#   macOS   ~/Library/Application Support/Cadence/.env
#   Linux   ~/.local/share/cadence/.env      (or $XDG_DATA_HOME/cadence)
#   Windows %APPDATA%\Cadence\.env
# Never commit real values.

# --- Server ---
PORT=8796                      # web app + API (loopback only). The https sign-in callback uses PORT+1.
# CADENCE_DIR=                 # override the data folder (database, brands, assets, logs, tls)

# --- Text agent (writes posts, runs the weekly plan) ---
# claude | codex | gemini | opencode | openai (any OpenAI-compatible API)
CADENCE_TEXT_PROVIDER=claude
CADENCE_MODEL=claude-sonnet-5-5
CADENCE_AGENT_CONTEXT=full     # full = the CLI also reads your own memory/skills (read-only tools); locked = nothing loaded
# CADENCE_CLAUDE_BIN=          # full path if the CLI is not on PATH (also CODEX / GEMINI / OPENCODE)
# CADENCE_CODEX_BIN=
# CADENCE_GEMINI_BIN=
# CADENCE_OPENCODE_BIN=
# For provider "openai":
# CADENCE_OPENAI_BASE_URL=https://api.openai.com/v1
# CADENCE_OPENAI_API_KEY=
# Optional second provider used when the first one fails:
# CADENCE_FALLBACK_PROVIDER=
# CADENCE_FALLBACK_MODEL=

# --- Images (default: openai when a key is set, else none) ---
CADENCE_IMAGE_PROVIDER=openai  # openai (needs a key) | none (branded layout, no AI photo) | catgpt | oga-mcp (opt-in local gateways)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible /images/generations
# CATGPT_GATEWAY_URL=http://localhost:8000/v1
# CATGPT_GATEWAY_TOKEN=
# CATGPT_IMAGE_MODEL=chatgpt
# CADENCE_OGA_MCP_ENTRY=       # path to an Open Generative AI MCP index.js

# --- Public media hosting (Instagram, Threads, Reddit and TikTok need a public image URL) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=cadence-media

# --- Rendering ---
# CADENCE_CHROMIUM_EXECUTABLE= # Chrome/Chromium/Edge path if auto-detection fails

# --- Social app credentials (create the app in each developer portal, see Accounts > Setup in the web app) ---
# CADENCE_X_CLIENT_ID=         CADENCE_X_CLIENT_SECRET=
# CADENCE_LINKEDIN_CLIENT_ID=  CADENCE_LINKEDIN_CLIENT_SECRET=
# CADENCE_INSTAGRAM_CLIENT_ID= CADENCE_INSTAGRAM_CLIENT_SECRET=
# CADENCE_FACEBOOK_CLIENT_ID=  CADENCE_FACEBOOK_CLIENT_SECRET=
# CADENCE_THREADS_CLIENT_ID=   CADENCE_THREADS_CLIENT_SECRET=
# CADENCE_PINTEREST_CLIENT_ID= CADENCE_PINTEREST_CLIENT_SECRET=
# CADENCE_REDDIT_CLIENT_ID=    CADENCE_REDDIT_CLIENT_SECRET=
# CADENCE_TIKTOK_CLIENT_ID=    CADENCE_TIKTOK_CLIENT_SECRET=
# Callback scheme per platform, if a portal rejects the default: CADENCE_<PLATFORM>_CALLBACK=http|https
