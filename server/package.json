{
  "name": "cadence-server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Cadence: your brand, on beat. Local-first social media manager (macOS, Linux, Windows)",
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-warnings src/index.js",
    "mcp": "node --no-warnings bin/cadence.mjs mcp",
    "test": "node --no-warnings --test tests/*.test.js",
    "doctor": "node --no-warnings bin/cadence.mjs doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "playwright": "1.61.1"
  },
  "bin": {
    "cadence": "bin/cadence.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
